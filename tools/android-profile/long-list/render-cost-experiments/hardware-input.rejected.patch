+    /** A hardware-backed input for the API 33 RuntimeShader rendering path. */
+    @TargetApi(33)
+    fun uploadShaderInput(texture: NativeFloatTexture): Bitmap {
+        val staging = upload(texture)
+        val hardware = staging.copy(Bitmap.Config.HARDWARE, false) ?: return staging
+        // Android may silently convert unsupported F16 hardware copies to 8888.
+        // Retain the original numeric pixels instead of accepting that loss.
+        val isF16 = hardware.hardwareBuffer.use { it.format == HardwareBuffer.RGBA_FP16 }
+        if (!isF16) {
+            hardware.recycle()
+            return staging
+        }
+        // copy() finishes the transfer before returning. Only this unpublished
+        // staging bitmap is recycled; shaders and display lists own prior inputs.
+        staging.recycle()
+        return hardware
     }

